          "belongs": "Node.js projects"
        },
        "relevanceDetector": {
          "about": "a package.json",
          "paths": {
            "source": "(^|/)package\\.json$",
            "flags": ""
          }
        }
      },
      {
        "id": "firebase",
        "ruleRoutingGuidance": {
          "belongs": "Firebase projects"
        },
        "relevanceDetector": {
          "about": "a firebase.json",
          "paths": {
            "source": "^firebase\\.json$",
            "flags": ""
          }
        }
      },
      {
        "id": "jwt",
        "relevanceDetector": {
          "about": "a JWT library",
          "paths": {
