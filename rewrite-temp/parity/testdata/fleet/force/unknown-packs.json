{
  "input": {
    "fn": "unknownPacks",
    "packs": [
      {
        "id": "node",
        "ruleRoutingGuidance": {
          "belongs": "Node.js projects"
        },
        "relevanceDetector": {
          "about": "a package.json",
          "paths": {
            "source": "(^|/)package\\.json$",
            "flags": ""
          }
        }
      },
      {
        "id": "firebase",
        "ruleRoutingGuidance": {
          "belongs": "Firebase projects"
        },
        "relevanceDetector": {
          "about": "a firebase.json",
          "paths": {
            "source": "^firebase\\.json$",
            "flags": ""
          }
        }
      },
      {
        "id": "jwt",
        "relevanceDetector": {
          "about": "a JWT library",
          "paths": {
            "source": "\\.(js|mjs)$",
            "flags": ""
          },
          "text": [
            {
              "source": "jsonwebtoken",
              "flags": ""
            }
          ],
          "search": [
            "jsonwebtoken"
          ]
        }
      },
      {
        "id": "asks",
        "questions": [
          {
            "id": "goals",
            "prompt": "What should it prove?"
          },
          {
            "id": "store",
            "prompt": "Where is the store?"
          }
        ],
        "relevanceDetector": null
      },
      {
        "id": "basics",
        "relevanceDetector": null
      }
    ],
    "addPacks": [
      "node",
      "nope",
      "asks",
      "also-nope"
    ]
  },
  "expect": [
    "nope",
    "also-nope"
  ]
}
