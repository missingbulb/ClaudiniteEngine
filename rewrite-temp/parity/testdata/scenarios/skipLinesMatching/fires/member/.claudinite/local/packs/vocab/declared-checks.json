[
  {
    "id": "v-skipLinesMatching",
    "on_fail": "block",
    "failureMessage": "the skipLinesMatching check",
    "fix": "fix the skipLinesMatching finding",
    "scanFiles": "/\\.txt$/",
    "skipLinesMatching": "/^#/",
    "matchLines": [
      {
        "match": "/MARK/",
        "what": "mark"
      }
    ]
  }
]
