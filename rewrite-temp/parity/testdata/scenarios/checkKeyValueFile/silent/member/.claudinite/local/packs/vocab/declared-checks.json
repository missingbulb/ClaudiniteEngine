[
  {
    "id": "v-checkKeyValueFile",
    "on_fail": "block",
    "checkKeyValueFile": [
      {
        "file": "release.config",
        "keys": [
          "a",
          "b"
        ],
        "whenMissing": {
          "what": "missing",
          "fix": "create it"
        },
        "whenLineNotKeyValue": {
          "what": "not KEY=value: \"{line}\"",
          "fix": "use KEY=value"
        },
        "whenKeyUnknown": {
          "what": "unknown key {key}",
          "fix": "drop it"
        },
        "whenKeyMissing": {
          "what": "missing key {key}",
          "fix": "add it"
        }
      }
    ]
  }
]
