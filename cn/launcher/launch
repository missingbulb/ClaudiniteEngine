#!/bin/sh
# Claudinite launcher. A member checks this file in as .claudinite/launch,
# unchanged; only the engine update replaces it.
#
#   sh .claudinite/launch <cn arguments>    fetch, verify and cache the pinned engine, then run it
#   sh .claudinite/launch env install       fetch, verify and cache only (environment pre-warm)
#
# It reads engine.version and engine.manifest from .claudinite/settings.yaml,
# .toml or .json, downloads that release's manifest.json and this platform's
# binary from the npm registry, or from the GitHub releases of the
# repository engine.releases names (owner/name, tag v<version>, assets named
# as npm's tarballs), checks the manifest against the pin and the
# binary against the manifest, caches the binary read-only, links
# .claudinite/bin/cn to it and execs it. Nothing is trusted that the pin
# does not cover; the registry's identity is immaterial to integrity.
#
# Only SessionStart and the Actions download step invoke it; every other hook
# runs .claudinite/bin/cn directly. Wired to Stop, its exit 2 on a refusal
# blocks the stop, and the next stop attempt hits it again, in a loop.
#
# Bootstrap: the @claudinite/cli packages carry this file as their bin, so
# `npx --yes @claudinite/cli init --packs ...` runs it from the package
# npx unpacked, through a symlink. Run with init and no settings file beside
# it, it takes the version and the binary's hash from the package's own
# manifest.json, fetches and checks the binary as above, caches it with the
# manifest and manifest.sig.json, and execs cn init, which verifies that
# signature before it writes anything. Windows is not covered: npm's shim
# for a sh script there is the desktop work.
# Any other command run through that bin runs the member's own pin, the
# member being the directory --repo names or else the working directory.
#
# CLAUDINITE_REGISTRY overrides the registry, CLAUDINITE_GITHUB the GitHub
# host releases are read from and CLAUDINITE_MAX_DOWNLOAD_BYTES the download
# size cap; all three exist for tests and the rehearsal.
set -u

registry=${CLAUDINITE_REGISTRY:-https://registry.npmjs.org}
github=${CLAUDINITE_GITHUB:-https://github.com}
max_bytes=${CLAUDINITE_MAX_DOWNLOAD_BYTES:-67108864}

if [ "${GITHUB_ACTIONS:-}" = true ]; then
  context=actions
elif [ "${1:-}" = hook ] && [ "${2:-}" = session-start ]; then
  context=session-start
elif [ "${1:-}" = hook ]; then
  context=guard
else
  context="command"
fi

tmp=
cleanup() {
  if [ -n "$tmp" ]; then
    chmod -R u+w "$tmp" 2>/dev/null
    rm -rf "$tmp"
    tmp=
  fi
}
trap cleanup EXIT
trap 'cleanup; exit 1' HUP INT TERM

say() {
  printf 'claudinite launch: %s\n' "$*" >&2
}

# A configuration or integrity failure: the engine never runs.
refuse() {
  cleanup
  say "$1"
  case $context in
    session-start)
      printf 'Claudinite refused to run its engine: %s: stop and ask the person before continuing.\n' "$1"
      exit 0 ;;
    guard) exit 2 ;;
    *) exit 1 ;;
  esac
}

# The registry could not be reached; nothing verified is cached.
unreachable() {
  cleanup
  case $context in
    session-start)
      say "could not fetch $1"
      printf 'Claudinite could not fetch its engine from %s: stop and ask the person before continuing.\n' "$1"
      exit 0 ;;
    guard)
      say "could not fetch the engine from $1; continuing without it, and SessionStart will say so again"
      exit 0 ;;
    *)
      say "could not fetch the engine from $1"
      exit 1 ;;
  esac
}

matches() {
  printf '%s\n' "$1" | grep -Eqx "$2"
}

# Step 1: the pin, from exactly one settings file.

here=$(cd "$(dirname "$0")" && pwd) || refuse "cannot locate the .claudinite folder"

# Run as the npm package's bin, through the symlink npm made.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self") || break
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
pkgdir=$(cd "$(dirname "$self")" && pwd) || refuse "cannot locate the launcher's folder"
bootstrap=
if [ -f "$pkgdir/manifest.json" ] && [ -f "$pkgdir/package.json" ]; then
  if [ "${1:-}" = init ]; then
    bootstrap=1
  else
    repo=.
    want=
    for arg do
      if [ -n "$want" ]; then
        want=
        [ -d "$arg" ] && repo=$arg
        continue
      fi
      case $arg in
        --) break ;;
        --repo|-repo) want=1 ;;
        --repo=*|-repo=*) [ -d "${arg#*=}" ] && repo=${arg#*=} ;;
      esac
    done
    here=$(cd "$repo" && pwd)/.claudinite || refuse "cannot locate the repository $repo"
  fi
fi

format=
count=0
for ext in yaml toml json; do
  if [ -f "$here/settings.$ext" ]; then
    format=$ext
    count=$((count + 1))
  fi
done

if [ -n "$bootstrap" ]; then
  settings=$pkgdir/manifest.json
  [ -f "$pkgdir/manifest.sig.json" ] || refuse "$pkgdir holds no manifest.sig.json, and cn init never runs from an unsigned manifest"
else
  [ "$count" -eq 1 ] || refuse "exactly one of .claudinite/settings.yaml, .claudinite/settings.toml or .claudinite/settings.json must exist, found $count in ${here%/.claudinite}"
  settings=$here/settings.$format
fi

if [ "$format" = json ] && [ -z "$bootstrap" ]; then
  engines=$(tr -d '\r\n' < "$settings" | grep -o '"engine"[[:blank:]]*:' | wc -l | tr -d ' ')
  [ "$engines" -eq 1 ] || refuse "$settings must hold exactly one \"engine\" object, found $engines"
fi

# The lines of the engine block, one key per line. No parser: the values the
# launcher needs are plain quoted strings, read with a strict pattern.
engine_block() {
  case $format in
    yaml) awk '/^engine:[ \t]*$/ { inb = 1; next } inb && /^[^ \t]/ { inb = 0 } inb { print }' "$settings" ;;
    toml) awk '/^\[engine\][ \t]*$/ { inb = 1; next } inb && /^[ \t]*\[/ { inb = 0 } inb { print }' "$settings" ;;
    json) tr -d '\r\n' < "$settings" | sed -n 's/.*"engine"[[:blank:]]*:[[:blank:]]*{\([^{}]*\)}.*/\1/p' | tr ',' '\n' ;;
  esac
}

# engine_value KEY: the key's quoted string, or empty when the key is absent.
# A key present twice, or not holding a plain quoted string, is refused.
engine_value() {
  case $format in toml) sep='=' ;; *) sep=':' ;; esac
  lines=$(engine_block | grep -E "^[[:blank:]]*\"?$1\"?[[:blank:]]*${sep}")
  [ -z "$lines" ] && return 0
  [ "$(printf '%s\n' "$lines" | wc -l | tr -d ' ')" -eq 1 ] || { echo "duplicate"; return 0; }
  value=$(printf '%s\n' "$lines" | sed -n "s/^[[:blank:]]*\"\{0,1\}$1\"\{0,1\}[[:blank:]]*${sep}[[:blank:]]*\"\([^\"]*\)\"[[:blank:]]*\$/\1/p")
  [ -n "$value" ] || value=malformed
  printf '%s\n' "$value"
}

if [ -n "$bootstrap" ]; then
  # The version and package as the package npx unpacked names them; the
  # manifest's own hash stands in for the pin.
  version=$(sed -n 's/^ *"version": *"\([0-9]*\.[0-9]*\.[0-9]*\)",\{0,1\}$/\1/p' "$pkgdir/manifest.json" | head -n 1)
  package=$(sed -n 's/^ *"name": *"\(@claudinite\/cli[-a-z]*\)",\{0,1\}$/\1/p' "$pkgdir/package.json" | head -n 1)
  matches "$version" '[0-9]+\.[0-9]+\.[0-9]+' || refuse "$pkgdir/manifest.json names no version"
  matches "$package" '@claudinite/cli(-rc)?' \
    || refuse "$pkgdir/package.json must name \"@claudinite/cli\" or \"@claudinite/cli-rc\""
else
  version=$(engine_value version)
  manifest_pin=$(engine_value manifest)
  package=$(engine_value package)
  [ -n "$package" ] || package=@claudinite/cli
  releases=$(engine_value releases)

  matches "$version" '[0-9]+\.[0-9]+\.[0-9]+' \
    || refuse "engine.version in $settings must be a quoted version like \"1.60928.1\""
  matches "$manifest_pin" 'sha512-[A-Za-z0-9+/]{86}==' \
    || refuse "engine.manifest in $settings must be a quoted sha512-... integrity string"
  matches "$package" '@claudinite/cli(-rc)?' \
    || refuse "engine.package in $settings must be \"@claudinite/cli\" or \"@claudinite/cli-rc\""
  [ -z "$releases" ] || matches "$releases" '[A-Za-z0-9-]+/[A-Za-z0-9_-][A-Za-z0-9._-]*' \
    || refuse "engine.releases in $settings must be a quoted GitHub repository like \"owner/name\""
fi

case $(uname -s) in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *) refuse "unsupported operating system $(uname -s)" ;;
esac
case $(uname -m) in
  x86_64|amd64) arch=x64 ;;
  aarch64|arm64) arch=arm64 ;;
  *) refuse "unsupported processor $(uname -m)" ;;
esac
bin=cn
bin_re=cn
if [ "$os" = windows ]; then
  [ "$arch" = x64 ] || refuse "unsupported platform windows-$arch"
  bin=cn.exe
  bin_re='cn\.exe'
fi
platform=$os-$arch

if command -v sha256sum >/dev/null 2>&1; then
  sha256() { sha256sum < "$1" | cut -d' ' -f1; }
  sha512() { sha512sum < "$1" | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
  sha256() { shasum -a 256 < "$1" | cut -d' ' -f1; }
  sha512() { shasum -a 512 < "$1" | cut -d' ' -f1; }
elif command -v openssl >/dev/null 2>&1; then
  sha256() { openssl dgst -sha256 < "$1" | sed 's/.*= *//'; }
  sha512() { openssl dgst -sha512 < "$1" | sed 's/.*= *//'; }
else
  refuse "no SHA-256 tool found (sha256sum, shasum or openssl)"
fi
for tool in curl tar; do
  command -v "$tool" >/dev/null 2>&1 || refuse "$tool is not installed; the launcher needs it to fetch the engine"
done

# The pin's SHA-512 as lowercase hex, to compare with the hash tools' output;
# the bootstrap's pin is the hash of the manifest npx unpacked.
if [ -n "$bootstrap" ]; then
  pin_hex=$(sha512 "$pkgdir/manifest.json")
else
  pin_hex=$(printf '%s\n' "${manifest_pin#sha512-}" | awk '
  BEGIN {
    a = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for (i = 0; i < 64; i++) v[substr(a, i + 1, 1)] = i
    h = "0123456789abcdef"
  }
  {
    bits = 0; nb = 0; out = ""
    for (i = 1; i <= length($0); i++) {
      c = substr($0, i, 1)
      if (c == "=") break
      bits = bits * 64 + v[c]; nb += 6
      if (nb >= 8) {
        nb -= 8; p = 2 ^ nb
        byte = int(bits / p); bits -= byte * p
        out = out substr(h, int(byte / 16) + 1, 1) substr(h, byte % 16 + 1, 1)
      }
    }
    print out
  }')
fi

# This platform's SHA-256 from a manifest.json whose hash matched the pin.
manifest_entry() {
  sed -n "s/^ *\"$platform\": {\"file\": \"$bin_re\", \"sha256\": \"\([0-9a-f]\{64\}\)\", \"size\": [0-9]*},\{0,1\}\$/\1/p" "$1"
}

# Step 2: the cache, re-hashed on every run.

if [ -z "${XDG_CACHE_HOME:-}" ] && [ -z "${HOME:-}" ]; then
  refuse "HOME is not set, so there is no cache folder (set HOME or XDG_CACHE_HOME)"
fi
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/claudinite
vdir=$cache_root/$version

private_dir() {
  if [ ! -d "$1" ]; then
    (umask 077 && mkdir -p "$1") || refuse "cannot create the cache directory $1"
  fi
  [ -L "$1" ] && refuse "the cache directory $1 is a symbolic link"
  [ "$os" = windows ] && return 0
  # shellcheck disable=SC2012 # ls -ldn is the portable way to read mode and uid
  set -- "$1" "$(ls -ldn "$1" | awk '{ print $1 " " $3 }')"
  case $2 in
    "drwx------ $(id -u)"|"drwx------. $(id -u)"|"drwx------+ $(id -u)"|"drwx------@ $(id -u)") ;;
    *) refuse "the cache directory $1 must be mode 0700 and owned by you (found ${2% *})" ;;
  esac
}
private_dir "$cache_root"
private_dir "$vdir"

cached_ok() {
  [ -f "$vdir/manifest.json" ] && [ -f "$vdir/$bin" ] || return 1
  [ "$(sha512 "$vdir/manifest.json")" = "$pin_hex" ] || return 1
  want=$(manifest_entry "$vdir/manifest.json")
  [ -n "$want" ] && [ "$(sha256 "$vdir/$bin")" = "$want" ]
}

if ! cached_ok; then
  chmod u+w "$vdir/manifest.json" "$vdir/$bin" 2>/dev/null
  rm -f "$vdir/manifest.json" "$vdir/$bin"

  # Step 3: download by exact tarball URL, HTTPS only, with a size cap.

  matches "$max_bytes" '[0-9]+' || refuse "CLAUDINITE_MAX_DOWNLOAD_BYTES must be a number"
  # A whole transfer may take as long as the cap at about 220 kB/s, and never
  # less than 30 s: the 64 MiB default allows about 300 s. --max-filesize
  # bounds only the compressed size, so the wall clock is what stops a
  # registry that stalls or trickles.
  max_time=$((max_bytes / 220000))
  [ "$max_time" -ge 30 ] || max_time=30
  tmp=$(mktemp -d "$vdir/.download.XXXXXX") || refuse "cannot create a temporary folder in $vdir"

  fetch() {
    curl --proto =https --proto-redir =https --tlsv1.2 --fail --silent --show-error --location \
      --connect-timeout 20 --max-time "$max_time" --max-filesize "$max_bytes" --output "$2" "$1" < /dev/null
    status=$?
    if [ "$status" -eq 63 ]; then
      refuse "$1 is larger than the $max_bytes-byte download cap"
    elif [ "$status" -ne 0 ]; then
      unreachable "$1"
    fi
    size=$(wc -c < "$2" | tr -d ' ')
    [ "$size" -le "$max_bytes" ] || refuse "$1 is larger than the $max_bytes-byte download cap"
  }

  name=${package#@claudinite/}
  if [ -n "${releases:-}" ]; then
    manifest_url=$github/$releases/releases/download/v$version/$name-$version.tgz
    binary_url=$github/$releases/releases/download/v$version/$name-$platform-$version.tgz
  else
    manifest_url=$registry/$package/-/$name-$version.tgz
    binary_url=$registry/$package-$platform/-/$name-$platform-$version.tgz
  fi

  fetch "$manifest_url" "$tmp/manifest.tgz"
  tar -xzf "$tmp/manifest.tgz" -C "$tmp" package/manifest.json 2>/dev/null \
    || refuse "$manifest_url holds no package/manifest.json"

  # Step 4: the manifest against the pin, the binary against the manifest.

  [ "$(sha512 "$tmp/package/manifest.json")" = "$pin_hex" ] \
    || refuse "manifest.json of $package $version does not match the pin in $settings"
  want=$(manifest_entry "$tmp/package/manifest.json")
  [ -n "$want" ] || refuse "$package $version lists no binary for $platform"

  mkdir "$tmp/platform" || refuse "cannot unpack into $tmp"
  fetch "$binary_url" "$tmp/platform.tgz"
  tar -xzf "$tmp/platform.tgz" -C "$tmp/platform" "package/bin/$bin" 2>/dev/null \
    || refuse "$binary_url holds no package/bin/$bin"
  [ "$(sha256 "$tmp/platform/package/bin/$bin")" = "$want" ] \
    || refuse "the $platform binary of $package $version does not match its manifest entry"

  if ! { chmod 0555 "$tmp/platform/package/bin/$bin" && chmod 0444 "$tmp/package/manifest.json" \
    && mv -f "$tmp/platform/package/bin/$bin" "$vdir/$bin" \
    && mv -f "$tmp/package/manifest.json" "$vdir/manifest.json"; }; then
    refuse "cannot place the engine in $vdir"
  fi
  cleanup
fi

if [ "${1:-}" = env ] && [ "${2:-}" = install ] && [ "$#" -eq 2 ]; then
  exit 0
fi

if [ -n "$bootstrap" ]; then
  chmod u+w "$vdir/manifest.sig.json" 2>/dev/null
  { cp "$pkgdir/manifest.sig.json" "$vdir/.manifest.sig.json.$$" && chmod 0444 "$vdir/.manifest.sig.json.$$" \
    && mv -f "$vdir/.manifest.sig.json.$$" "$vdir/manifest.sig.json"; } || refuse "cannot place manifest.sig.json in $vdir"
  exec "$vdir/$bin" "$@"
fi

# Step 5: link, unpack, run.

mkdir -p "$here/bin" || refuse "cannot create $here/bin"
if ! ln -sfn "$vdir/$bin" "$here/bin/$bin" 2>/dev/null; then
  rm -f "$here/bin/$bin"
  cp "$vdir/$bin" "$here/bin/$bin" || refuse "cannot link or copy the engine into $here/bin"
fi
# Unpacking the embedded runner script and SDK beside the binary is a no-op
# until the engine embeds them (no pack JavaScript runs yet).
exec "$vdir/$bin" "$@"
